# Local frontend development (npm run dev).
# Copy to .env and adjust if your backend or AI service runs elsewhere.
VITE_API_URL=http://localhost:8080
VITE_AI_URL=http://localhost:8000

# Optional: only if the AI service is started with AI_API_KEY.
# This value is visible in the browser bundle, so do not treat it as a secret.
VITE_AI_API_KEY=

# Monitored support inbox shown on the public and legal pages.
VITE_SUPPORT_EMAIL=support@your-domain.example
