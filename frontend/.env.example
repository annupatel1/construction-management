# Copy to .env if your backend runs somewhere else
VITE_API_URL=http://localhost:8080

# Multimodal AI service (ai_platform). Use your deployed HTTPS URL in production.
VITE_AI_URL=http://localhost:8000
# Optional shared key for the AI service. Leave empty when AI_API_KEY is not set.
VITE_AI_API_KEY=

# Public support contact shown on the Support and Privacy pages (replace before a real pilot)
VITE_SUPPORT_EMAIL=support@buildtrack.example
