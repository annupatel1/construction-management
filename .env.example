# ==========================================================
# BuildTrack — environment variables
# ==========================================================
# Copy this file to .env and replace every placeholder before deploying.
# Never commit a real secret.
#
# Generate strong secrets:
#   openssl rand -hex 32
# ==========================================================

# ---------- Database (Docker Compose) ----------
DB_NAME=construction_management_db
DB_ROOT_PASSWORD=change-me-root-password
DB_USERNAME=buildtrack
DB_PASSWORD=change-me-database-password

# ---------- Database (local backend, outside Compose) ----------
DB_URL=jdbc:mysql://localhost:3306/construction_management_db

# ---------- Authentication ----------
JWT_SECRET=replace-with-a-random-32-plus-character-secret
OTP_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_EXPIRATION=86400000
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Site photo uploads ----------
# Photos are stored in the uploads-data Docker volume. These defaults allow
# 10 MB per photo. Keep UPLOAD_MAX_BYTES and UPLOAD_MAX_FILE_SIZE in sync.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB

# ---------- OTP delivery ----------
# Email OTP is free and is the default. Phone/SMS OTP is optional and costs money.
# Local development: email CONSOLE prints the code in the backend log.
# Production: OTP_EMAIL_DELIVERY=EMAIL and OTP_PHONE_DELIVERY=DISABLED.
OTP_PHONE_DELIVERY=DISABLED
OTP_EMAIL_DELIVERY=CONSOLE

# MSG91 (only when OTP_PHONE_DELIVERY=SMS; requires an approved DLT template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# SMTP (required when OTP_EMAIL_DELIVERY=EMAIL). A free mailbox is enough:
#   Gmail: smtp.gmail.com, port 587, your Gmail address, and a 16-character App Password.
#   Brevo/other free transactional providers: use their SMTP host/port/credentials.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example

# ---------- Spring profile ----------
# Use "prod" in production. The prod profile rejects weak secrets, reused
# JWT/OTP secrets, console OTP delivery and missing SMTP settings. Phone OTP
# stays optional; email OTP is the required free channel.
# Docker Compose normally lets a host environment variable override .env.
# make up / make prod-up unset every key defined in .env so this file wins.
SPRING_PROFILES_ACTIVE=default
PORT=8080

# ---------- AI service ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AI_API_KEY=

# ---------- Frontend (build-time for Docker Compose) ----------
VITE_API_URL=http://localhost:8080
VITE_AI_URL=http://localhost:8000
# Optional: only when the AI service is started with AI_API_KEY. This value is
# visible in the browser bundle, so it is not a replacement for a real secret.
VITE_AI_API_KEY=
VITE_SUPPORT_EMAIL=support@your-domain.example

# ---------- Production reverse proxy (optional) ----------
# Used only when running:
#   docker compose --profile proxy up -d --build
# DOMAIN must be a real DNS name pointing at this server. Caddy obtains and
# renews HTTPS certificates automatically. Open ports 80 and 443.
DOMAIN=
ACME_EMAIL=

# For production, replace the local defaults above with the public URLs:
#   SPRING_PROFILES_ACTIVE=prod
#   CORS_ORIGINS=https://your-domain.example
#   AI_ALLOWED_ORIGINS=https://your-domain.example
#   VITE_API_URL=https://your-domain.example
#   VITE_AI_URL=https://your-domain.example/ai
#   VITE_SUPPORT_EMAIL=support@your-domain.example
# and configure email OTP (free):
#   OTP_PHONE_DELIVERY=DISABLED
#   OTP_EMAIL_DELIVERY=EMAIL + SPRING_MAIL_*, MAIL_FROM
# Optional paid SMS OTP: OTP_PHONE_DELIVERY=SMS + MSG91_AUTH_KEY, MSG91_TEMPLATE_ID
