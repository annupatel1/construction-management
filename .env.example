# ==========================================================
# Construction Management Platform - Environment Variables
# ==========================================================
# Copy this file to .env and fill in real values for production.
# Never commit actual secrets to version control.
# ==========================================================

# Database Configuration
DB_URL="jdbc:mysql://localhost:3306/construction_management_db"
DB_USERNAME="root"
DB_PASSWORD="root"

# JWT Security - MUST BE 32+ CHARACTERS FOR PRODUCTION
# Generate: openssl rand -hex 32
JWT_SECRET="dev-only-secret-change-before-deploying-must-be-32-chars-long-jwt"

# CORS Origins (comma-separated list for production)
# Example: CORS_ORIGINS="https://your-domain.com,https://admin.your-domain.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# OTP Delivery Configuration
# Phone (SMS via MSG91): Set OTP_PHONE_DELIVERY=SMS
# Email (SMTP): Set OTP_EMAIL_DELIVERY=EMAIL
OTP_PHONE_DELIVERY=CONSOLE
OTP_EMAIL_DELIVERY=CONSOLE

# MSG91 SMS Service (Get from https://msg91.com)
# REQUIRED if OTP_PHONE_DELIVERY=SMS
MSG91_AUTH_KEY="your-msg91-auth-key-here"
MSG91_TEMPLATE_ID="your-dlt-approved-template-id"

# Email SMTP Configuration (Get if OTP_EMAIL_DELIVERY=EMAIL)
# Gmail example:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-gmail-app-password
# MAIL_FROM=your-email@gmail.com

# OTP Settings
OTP_SECRET="${JWT_SECRET}"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5

# Server Port
PORT=8080
